---
// Draft banner for the gated model page. Names the viewer (first name and email from GET /me)
// and lays a low-opacity, repeated email watermark over the whole page, print included.
---

<div
  id="model-draft-banner"
  class="sticky top-0 z-50 border-b border-ai-gold/40 bg-provider-blue-dark text-white print:static"
  role="region"
  aria-label="Draft notice"
>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3 lg:px-16">
    <div class="flex items-center gap-3">
      <a href="https://www.metriasmedical.com/" class="shrink-0 rounded-md bg-white/95 p-1.5" aria-label="Metrias Medical home">
        <img src="/images/brand/metrias-logo-static-v1.png" alt="Metrias Medical" width="28" height="28" class="h-7 w-7 object-contain" />
      </a>
      <span class="rounded-full bg-ai-gold px-3 py-1 font-body text-xs font-bold uppercase tracking-wide text-provider-blue-dark">
        Draft
      </span>
      <p class="font-body text-sm text-white/90">
        Working draft for discussion.<span class="hidden sm:inline">
          Figures are illustrative and will change. Not an offer to sell securities.</span>
      </p>
    </div>
    <p class="font-body text-sm text-white/80" data-viewer-line hidden>
      Prepared for <span class="font-semibold text-white" data-viewer-first-name></span>
      (<span data-viewer-email></span>).<span class="hidden sm:inline"> Please do not forward.</span>
    </p>
  </div>
</div>

<div id="model-watermark" class="model-watermark" aria-hidden="true"></div>

<style>
  .model-watermark {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.07;
    background-repeat: repeat;
    background-size: 360px 200px;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
</style>

<script>
  import { getViewer } from '../../lib/modelViewer';

  function xmlEscape(s: string): string {
    return s.replace(/[<>&'"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', "'": '&apos;', '"': '&quot;' })[c] ?? c);
  }

  function watermarkTile(text: string): string {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="360" height="200">` +
      `<text x="180" y="100" text-anchor="middle" dominant-baseline="middle" ` +
      `transform="rotate(-24 180 100)" font-family="Manrope, system-ui, sans-serif" ` +
      `font-size="15" font-weight="600" fill="#253780">${xmlEscape(text)}</text></svg>`;
    return `url("data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}")`;
  }

  void getViewer().then((viewer) => {
    if (!viewer) return;
    const banner = document.getElementById('model-draft-banner');
    const line = banner?.querySelector<HTMLElement>('[data-viewer-line]');
    const first = banner?.querySelector<HTMLElement>('[data-viewer-first-name]');
    const email = banner?.querySelector<HTMLElement>('[data-viewer-email]');
    if (first) first.textContent = viewer.first_name || viewer.email;
    if (email) email.textContent = viewer.email;
    if (line) line.hidden = false;

    const mark = document.getElementById('model-watermark');
    if (mark && viewer.email) mark.style.backgroundImage = watermarkTile(viewer.email);
  });
</script>
